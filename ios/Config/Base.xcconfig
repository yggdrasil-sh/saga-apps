// Oeffentliche Grundeinstellungen fuer alle Ziele (App, Widget, Teilen-Erweiterungen).
// Eigene Werte (Team-ID, App-ID, App-Gruppe, Vorgabe-Server) NICHT hier eintragen, sondern in
// Config/Local.xcconfig (nicht versioniert) - Vorlage: Config/Local.xcconfig.example.

// App-ID der Haupt-App; Erweiterungen haengen .widget / .share / .sharemac an
SAGA_BUNDLE_ID = io.github.yggdrasil-sh.saga
// App-Gruppe (gemeinsame Einstellungen von App, Widget und Teilen)
SAGA_APP_GROUP = group.$(SAGA_BUNDLE_ID)
// macOS: Gruppe mit Team-Praefix (TEAMID.<App-ID>) - braucht kein Bereitstellungsprofil und laeuft
// daher auch in Developer-ID-Builds (DMG ausserhalb des App Store). group.-Gruppen braeuchten auf dem Mac ein Profil.
SAGA_APP_GROUP[sdk=macosx*] = $(TeamIdentifierPrefix)$(SAGA_BUNDLE_ID)
// Gemeinsame Schluesselbund-Gruppe (App, Widget, Teilen) fuer den App-Schluessel; den Team-Praefix setzt Xcode beim Signieren
SAGA_KEYCHAIN_GROUP = $(AppIdentifierPrefix)$(SAGA_BUNDLE_ID).shared
// macOS: die App-Gruppe dient als Schluesselbund-Gruppe (keychain-access-groups braeuchte dort ein Bereitstellungsprofil)
SAGA_KEYCHAIN_GROUP[sdk=macosx*] = $(SAGA_APP_GROUP)
// Apple-Team fuer die Signierung (leer = in Xcode waehlen bzw. unsigniert pruefen)
DEVELOPMENT_TEAM =
// Optional: vorbelegte Server-Adresse (leer = Anmeldebildschirm fragt nach dem Server)
SAGA_DEFAULT_SERVER =
// Optional: umgezogene Server-Adressen "alt=neu" (mehrere durch Leerzeichen getrennt)
SAGA_MOVED_SERVERS =

// Mitteilungen (APNs) in der Mac-App: braucht ein Bereitstellungsprofil mit Push-Berechtigung (also nicht fuer
// ad-hoc signierte DMG-Builds). Zum Einschalten in Config/Local.xcconfig: SAGA_MAC_PUSH_SUFFIX = -push
// (nutzt dann App/App-macOS-push.entitlements). iOS/iPadOS haben die Berechtigung immer (App-iOS.entitlements).
SAGA_MAC_PUSH_SUFFIX =

#include? "Local.xcconfig"
