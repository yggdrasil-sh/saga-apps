# Lokale Einstellungen fuer die Build-Skripte (build-adhoc.sh, build-testflight.sh, build-install.sh).
# Kopieren nach Config/local.env (wird NICHT eingecheckt) und anpassen:
#   cp Config/local.env.example Config/local.env
# Die Datei wird per "." eingelesen (Shell-Syntax). Alles ist optional.

# Team-ID fuer den Export (Vorgabe: DEVELOPMENT_TEAM aus Config/Local.xcconfig)
# SAGA_TEAM_ID=ABCDE12345

# App-ID (Vorgabe: SAGA_BUNDLE_ID aus Config/Local.xcconfig) - nur fuer Meldungen und zum Beenden der Mac-App
# SAGA_BUNDLE_ID=com.example.saga

# Geraete-ID (UDID) des iPhones/iPads fuer build-install.sh ("xcrun devicectl list devices")
# SAGA_DEVICE_ID=00000000-0000000000000000

# Programm, das build-adhoc.sh nach dem Bauen mit dem Pfad der .ipa aufruft (z. B. Upload ins MDM)
# SAGA_PUBLISH_CMD="$HOME/bin/mdm-upload"

# Hinweis, den build-testflight.sh nach dem Upload als "Status:" ausgibt
# SAGA_STATUS_HINT="App Store Connect -> Apps -> TestFlight"
