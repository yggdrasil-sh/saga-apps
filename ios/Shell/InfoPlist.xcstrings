{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoanrufe führen und Fotos für Notizen aufnehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make video calls and take photos for notes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer videollamadas y fotos para notas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видеозвонки и фото для заметок"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โทรวิดีโอและถ่ายรูปสำหรับโน้ต"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Audio- und Videoanrufen sprechen und Sprachnachrichten aufnehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk in audio and video calls and record voice messages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hablar en llamadas de audio y vídeo y grabar mensajes de voz"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разговаривать в аудио- и видеозвонках и записывать голосовые сообщения"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูดคุยในการโทรเสียงและวิดีโอ และบันทึกข้อความเสียง"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufe verbinden sich nach Möglichkeit direkt mit Geräten in deinem Netzwerk"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calls connect directly to devices in your network when possible"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas se conectan directamente con dispositivos de tu red cuando es posible"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонки по возможности соединяются напрямую с устройствами в вашей сети"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การโทรจะเชื่อมต่อกับอุปกรณ์ในเครือข่ายของคุณโดยตรงเมื่อเป็นไปได้"
          }
        }
      }
    }
  },
  "version": "1.0"
}