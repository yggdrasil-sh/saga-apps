    "Die Anmeldung dieses Geräts und alle lokal gespeicherten Daten der App werden gelöscht.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung dieses Geräts und alle lokal gespeicherten Daten der App werden gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device's sign-in and all data the app stored locally will be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán el inicio de sesión de este dispositivo y todos los datos guardados localmente por la app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход этого устройства и все локальные данные приложения будут удалены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าสู่ระบบของอุปกรณ์นี้และข้อมูลทั้งหมดที่แอปเก็บไว้ในเครื่องจะถูกลบ"
          }
        }
      }
    },
    "Diese Anmeldung gilt nicht mehr. Bitte neu anmelden.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anmeldung gilt nicht mehr. Bitte neu anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sign-in is no longer valid. Please sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este inicio de sesión ya no es válido. Vuelve a iniciar sesión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот вход больше не действует. Войдите снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าสู่ระบบนี้ใช้ไม่ได้แล้ว กรุณาเข้าสู่ระบบอีกครั้ง"
          }
        }
      }
    },
    "Diese Testfassung meldet sich über den Browser an. Kopplungslinks folgen später.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Testfassung meldet sich über den Browser an. Kopplungslinks folgen später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This test version signs in through the browser. Pairing links will follow later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de prueba inicia sesión a través del navegador. Los enlaces de vinculación llegarán más adelante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта тестовая версия входит через браузер. Ссылки для связывания появятся позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันทดสอบนี้เข้าสู่ระบบผ่านเบราว์เซอร์ ลิงก์จับคู่จะตามมาภายหลัง"
          }
        }
      }
    },
