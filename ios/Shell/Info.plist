		<string>de</string>
		<string>en</string>
		<string>es</string>
		<string>th</string>
		<string>ru</string>
	</array>
	<key>CFBundleName</key>
	<string>Saga Web</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
