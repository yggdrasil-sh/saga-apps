        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take photos for notes, scan QR codes to sign in and make video calls"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacer fotos para notas, escanear códigos QR para iniciar sesión y hacer videollamadas"
