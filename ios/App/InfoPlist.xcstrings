        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото для заметок, сканирование QR-кодов для входа и видеозвонки"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ่ายรูปสำหรับโน้ต สแกนคิวอาร์โค้ดเพื่อเข้าสู่ระบบ และโทรวิดีโอ"
