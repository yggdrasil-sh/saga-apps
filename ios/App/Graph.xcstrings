    "Archivierte Seiten, Vorlagen und Seiten anderer Server erscheinen hier nicht.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte Seiten, Vorlagen und Seiten anderer Server erscheinen hier nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived pages, templates and pages from other servers don’t appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas archivadas, las plantillas y las páginas de otros servidores no aparecen aquí."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าที่เก็บถาวร เทมเพลต และหน้าจากเซิร์ฟเวอร์อื่นจะไม่แสดงที่นี่"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивные страницы, шаблоны и страницы других серверов здесь не показываются."
          }
        }
      }
    },
