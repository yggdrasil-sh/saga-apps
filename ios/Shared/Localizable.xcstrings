    "„%@“ bekommt dann keine Mitteilungen mehr." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ bekommt dann keine Mitteilungen mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will no longer receive push notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» dejará de recibir notificaciones push."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» больше не будет получать push-уведомления."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” จะไม่ได้รับการแจ้งเตือนแบบพุชอีก"
