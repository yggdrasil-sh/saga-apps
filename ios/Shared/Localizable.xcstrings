    "Gilt für alle Seiten auf diesem Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für alle Seiten auf diesem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to all pages on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a todas las páginas en este Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует для всех страниц на этом Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กับทุกหน้าบน Mac เครื่องนี้"
          }
        }
      }
    },
    "Gilt für alle Seiten auf diesem Mac. Alternativ die Unterkante des Titelbilds ziehen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für alle Seiten auf diesem Mac. Alternativ die Unterkante des Titelbilds ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to all pages on this Mac. You can also drag the bottom edge of the cover image."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a todas las páginas en este Mac. También puedes arrastrar el borde inferior de la portada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует для всех страниц на этом Mac. Можно также перетащить нижний край обложки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กับทุกหน้าบน Mac เครื่องนี้ คุณยังลากขอบล่างของภาพปกได้ด้วย"
          }
        }
      }
    },
    "Gilt nur für Saga auf diesem Mac. „Automatisch“ folgt der Systemsprache." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt nur für Saga auf diesem Mac. „Automatisch“ folgt der Systemsprache."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies only to Saga on this Mac. “Automatic” follows the system language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se aplica a Saga en este Mac. «Automático» sigue el idioma del sistema."
