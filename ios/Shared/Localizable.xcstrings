    "Dein Admin verlangt einen zweiten Faktor – bitte im Browser einrichten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Admin verlangt einen zweiten Faktor – bitte im Browser einrichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your admin requires a second factor – please set it up in the browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu administrador exige un segundo factor: configúralo en el navegador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Администратор требует второй фактор – настрой его в браузере."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ดูแลระบบของคุณกำหนดให้ใช้ปัจจัยที่สอง – โปรดตั้งค่าในเบราว์เซอร์"
