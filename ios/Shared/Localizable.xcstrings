    "Die Sicherheitsnummer von %@ hat sich geändert – erst im Chat prüfen oder „Verstanden“ wählen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherheitsnummer von %@ hat sich geändert – erst im Chat prüfen oder „Verstanden“ wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'s safety number has changed – check it in the chat first or choose “Got it”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El número de seguridad de %@ ha cambiado: compruébalo primero en el chat o elige «Entendido»."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код безопасности %@ изменился – сначала проверь его в чате или выбери «Понятно»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หมายเลขความปลอดภัยของ %@ เปลี่ยนไป – ตรวจสอบในแชทก่อนหรือเลือก “รับทราบ”"
          }
        }
      }
    },
    "Direktverbindung nicht möglich (z. B. strenge Firewall oder Mobilfunknetz). Der Admin kann einen TURN-Server eintragen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktverbindung nicht möglich (z. B. strenge Firewall oder Mobilfunknetz). Der Admin kann einen TURN-Server eintragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct connection not possible (e.g. strict firewall or mobile network). The admin can configure a TURN server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es posible una conexión directa (p. ej. cortafuegos estricto o red móvil). El administrador puede configurar un servidor TURN."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прямое соединение невозможно (например, строгий брандмауэр или мобильная сеть). Администратор может настроить TURN-сервер."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อโดยตรงไม่ได้ (เช่น ไฟร์วอลล์เข้มงวดหรือเครือข่ายมือถือ) ผู้ดูแลระบบสามารถกำหนดค่าเซิร์ฟเวอร์ TURN ได้"
          }
        }
      }
    },
