    "Saga – Wiederherstellungsschlüssel für Chats" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga – Wiederherstellungsschlüssel für Chats"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga – recovery key for chats"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga – clave de recuperación de los chats"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga – ключ восстановления для чатов"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga – คีย์กู้คืนสำหรับแชท"
          }
        }
