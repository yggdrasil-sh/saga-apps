    "✓ Zugestellt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✓ Zugestellt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✓ Delivered"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✓ Entregada"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✓ Доставлено"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "✓ ส่งถึงแล้ว"
          }
        }
      }
    },
    "Beides nicht mehr vorhanden? Neue Schlüssel – ältere Nachrichten sind danach nicht mehr lesbar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beides nicht mehr vorhanden? Neue Schlüssel – ältere Nachrichten sind danach nicht mehr lesbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neither available any more? New keys – earlier messages can't be read afterwards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya no tienes ninguna de las dos? Claves nuevas: después no podrás leer los mensajes anteriores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни того, ни другого больше нет? Новые ключи – прежние сообщения после этого прочитать будет нельзя."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีทั้งสองอย่างแล้ว? คีย์ใหม่ – หลังจากนั้นจะอ่านข้อความก่อนหน้าไม่ได้"
          }
        }
      }
    },
    "Dafür bekommst du gleich einen Wiederherstellungsschlüssel. Damit holst du deine Chats auf ein neues Gerät, wenn kein anderes mehr da ist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafür bekommst du gleich einen Wiederherstellungsschlüssel. Damit holst du deine Chats auf ein neues Gerät, wenn kein anderes mehr da ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll get a recovery key in a moment. With it you can bring your chats to a new device when no other device is left."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un momento recibirás una clave de recuperación. Con ella puedes llevar tus chats a un dispositivo nuevo cuando no te quede ningún otro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас ты получишь ключ восстановления. С ним ты сможешь перенести чаты на новое устройство, когда другого устройства уже не останется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะได้รับคีย์กู้คืนในอีกสักครู่ ด้วยคีย์นี้ คุณจะย้ายแชทไปยังอุปกรณ์ใหม่ได้เมื่อไม่มีอุปกรณ์อื่นเหลืออยู่"
          }
        }
      }
    },
    "Diese Nachricht konnte keinem bestätigten Gerät des Absenders zugeordnet werden – z. B. weil das Gerät inzwischen entfernt wurde. Vergleiche im Zweifel die Sicherheitsnummer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Nachricht konnte keinem bestätigten Gerät des Absenders zugeordnet werden – z. B. weil das Gerät inzwischen entfernt wurde. Vergleiche im Zweifel die Sicherheitsnummer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This message couldn't be matched to a confirmed device of the sender – e.g. because the device has since been removed. If in doubt, compare the safety number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mensaje no se pudo asociar a ningún dispositivo confirmado del remitente, p. ej., porque el dispositivo se ha quitado entretanto. Si tienes dudas, compara el número de seguridad."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это сообщение не удалось сопоставить с подтверждённым устройством отправителя – например, потому что устройство с тех пор удалено. Если сомневаешься, сравни код безопасности."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถจับคู่ข้อความนี้กับอุปกรณ์ที่ยืนยันแล้วของผู้ส่งได้ – เช่น เพราะอุปกรณ์ถูกนำออกไปแล้ว หากไม่แน่ใจ ให้เปรียบเทียบหมายเลขความปลอดภัย"
          }
        }
      }
    },
    "Diese Seite liegt auf %@. Hier kannst du sie lesen und kommentieren." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Seite liegt auf %@. Hier kannst du sie lesen und kommentieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This page is on %@. Here you can read and comment on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
