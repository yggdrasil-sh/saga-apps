    "angemeldet %@ · zuletzt %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "angemeldet %@ · zuletzt %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "signed in %@ · last used %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sesión iniciada %@ · último uso %@"
          }
        }
      }
    },
    "Angemeldete Apps bleiben angemeldet. Zu jeder gehört ein kleiner Schlüssel für Widget, Teilen und Kurzbefehle. Verlorenes Gerät → abmelden, dann ist beides weg." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldete Apps bleiben angemeldet. Zu jeder gehört ein kleiner Schlüssel für Widget, Teilen und Kurzbefehle. Verlorenes Gerät → abmelden, dann ist beides weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps stay signed in. Each one comes with a small key for widgets, sharing and shortcuts. Lost a device? Sign it out and both are gone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps mantienen la sesión iniciada. Cada una tiene una pequeña clave para widgets, compartir y atajos. ¿Perdiste un dispositivo? Cierra su sesión y ambas desaparecen."
          }
        }
      }
    },
