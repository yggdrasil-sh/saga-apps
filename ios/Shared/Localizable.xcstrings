    "Die Nachricht und ihre Anhänge werden vom Server gelöscht. Wer sie schon gelesen hat, kann eine Kopie haben." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht und ihre Anhänge werden vom Server gelöscht. Wer sie schon gelesen hat, kann eine Kopie haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The message and its attachments will be deleted from the server. Anyone who already read it may have a copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mensaje y sus adjuntos se eliminarán del servidor. Quien ya lo haya leído puede tener una copia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщение и его вложения будут удалены с сервера. У тех, кто уже прочитал его, может остаться копия."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความและไฟล์แนบจะถูกลบจากเซิร์ฟเวอร์ ผู้ที่อ่านไปแล้วอาจมีสำเนาอยู่"
          }
        }
      }
    },
    "Die Schlüssel werden von diesem Gerät gelöscht. Danach brauchst du ein anderes Gerät oder den Wiederherstellungsschlüssel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schlüssel werden von diesem Gerät gelöscht. Danach brauchst du ein anderes Gerät oder den Wiederherstellungsschlüssel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keys will be deleted from this device. Afterwards you'll need another device or the recovery key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves se eliminarán de este dispositivo. Después necesitarás otro dispositivo o la clave de recuperación."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи будут удалены с этого устройства. После этого понадобится другое устройство или ключ восстановления."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คีย์จะถูกลบจากอุปกรณ์นี้ หลังจากนั้นคุณจะต้องใช้อุปกรณ์อื่นหรือคีย์กู้คืน"
          }
        }
      }
    },
