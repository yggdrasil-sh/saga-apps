    },
    "%@ in diesem Chat erlauben" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in diesem Chat erlauben"
          }
        },
        "en" : {
          "stringUnit" : {
