    "Nicht dein Anmeldename: wähle etwas, das alle sehen dürfen. 2–32 Zeichen, a–z, 0–9, - und _." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht dein Anmeldename: wähle etwas, das alle sehen dürfen. 2–32 Zeichen, a–z, 0–9, - und _."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not your username: pick something everyone may see. 2–32 characters, a–z, 0–9, - and _."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es tu nombre de usuario: elige algo que todos puedan ver. 2–32 caracteres, a–z, 0–9, - y _."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не твоё имя пользователя: выбери то, что могут видеть все. 2–32 символа, a–z, 0–9, - и _."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ใช่ชื่อผู้ใช้ของคุณ: เลือกชื่อที่ทุกคนเห็นได้ 2–32 ตัวอักษร a–z, 0–9, - และ _"
          }
        }
      }
    },
    "Privat wird sie erst, wenn dort „Unterseiten mit veröffentlichen“ aus ist oder die Seite verschoben wird." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privat wird sie erst, wenn dort „Unterseiten mit veröffentlichen“ aus ist oder die Seite verschoben wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only becomes private when “Also publish subpages” is turned off there or the page is moved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo vuelve a ser privada si allí se desactiva «Publicar también las subpáginas» o si se mueve la página."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она станет закрытой, только если там выключить «Публиковать и подстраницы» или переместить страницу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าจะเป็นส่วนตัวก็ต่อเมื่อปิด “เผยแพร่หน้าย่อยด้วย” ที่นั่น หรือย้ายหน้าไป"
          }
        }
      }
    },
    "Sonst bitten wir Suchmaschinen, die Seite nicht aufzunehmen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonst bitten wir Suchmaschinen, die Seite nicht aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otherwise search engines are asked not to index the page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no, se pide a los buscadores que no indexen la página."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иначе поисковые системы попросят не индексировать страницу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มิฉะนั้นจะขอให้เครื่องมือค้นหาไม่จัดทำดัชนีหน้านี้"
          }
        }
      }
    },
    "Steht in den Adressen deiner öffentlichen Seiten (%@). Beim Ändern funktionieren alte Links nicht mehr." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steht in den Adressen deiner öffentlichen Seiten (%@). Beim Ändern funktionieren alte Links nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appears in the addresses of your public pages (%@). If you change it, old links stop working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece en las direcciones de tus páginas públicas (%@). Si lo cambias, los enlaces antiguos dejarán de funcionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Появляется в адресах твоих публичных страниц (%@). Если изменить его, старые ссылки перестанут работать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรากฏในที่อยู่ของหน้าสาธารณะของคุณ (%@) หากเปลี่ยน ลิงก์เดิมจะใช้งานไม่ได้"
          }
        }
      }
    },
    "Steht in den Adressen deiner öffentlichen Seiten (…/@name/…) und ist für alle sichtbar – nicht dein Anmeldename. Wird beim ersten Veröffentlichen festgelegt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steht in den Adressen deiner öffentlichen Seiten (…/@name/…) und ist für alle sichtbar – nicht dein Anmeldename. Wird beim ersten Veröffentlichen festgelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appears in the addresses of your public pages (…/@name/…) and is visible to everyone – not your username. Set when you first publish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece en las direcciones de tus páginas públicas (…/@name/…) y es visible para todos; no es tu nombre de usuario. Se fija al publicar por primera vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Появляется в адресах твоих публичных страниц (…/@name/…) и виден всем – это не твоё имя пользователя. Задаётся при первой публикации."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรากฏในที่อยู่ของหน้าสาธารณะของคุณ (…/@name/…) และทุกคนมองเห็นได้ – ไม่ใช่ชื่อผู้ใช้ของคุณ ตั้งเมื่อเผยแพร่ครั้งแรก"
          }
        }
      }
    },
