        }
      }
    },
    "Das lässt sich nicht rückgängig machen. Wer Nachrichten schon gesehen hat, kann Kopien davon haben." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das lässt sich nicht rückgängig machen. Wer Nachrichten schon gesehen hat, kann Kopien davon haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This can't be undone. Anyone who has already seen messages may have copies of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede deshacer. Quien ya haya visto los mensajes puede tener copias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это нельзя отменить. У тех, кто уже видел сообщения, могут остаться копии."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้เลิกทำไม่ได้ ผู้ที่เห็นข้อความแล้วอาจมีสำเนาอยู่"
          }
        }
      }
    },
