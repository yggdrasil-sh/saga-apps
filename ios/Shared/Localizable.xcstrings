    "Die Sicherheitsnummer von %@ hat sich geändert – erst prüfen oder „Verstanden“ wählen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherheitsnummer von %@ hat sich geändert – erst prüfen oder „Verstanden“ wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'s safety number has changed – check it first or choose “Got it”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El número de seguridad de %@ ha cambiado: compruébalo primero o elige «Entendido»."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
