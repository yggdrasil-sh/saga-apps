    "Neue Schlüssel: Bisherige Nachrichten sind dann für dich nicht mehr lesbar, deine anderen Geräte werden abgemeldet und deine Gesprächspartner sehen eine geänderte Sicherheitsnummer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Schlüssel: Bisherige Nachrichten sind dann für dich nicht mehr lesbar, deine anderen Geräte werden abgemeldet und deine Gesprächspartner sehen eine geänderte Sicherheitsnummer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New keys: you won't be able to read earlier messages, your other devices will be signed out and your contacts will see a changed safety number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claves nuevas: ya no podrás leer los mensajes anteriores, tus otros dispositivos se desconectarán y tus contactos verán un número de seguridad cambiado."
          }
        }
      }
    },
