    "Der Verlauf verschwindet nur bei dir, auf allen deinen Geräten. %@ behält ihn. Der Chat erscheint wieder, sobald eine neue Nachricht kommt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verlauf verschwindet nur bei dir, auf allen deinen Geräten. %@ behält ihn. Der Chat erscheint wieder, sobald eine neue Nachricht kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The history disappears only for you, on all your devices. %@ keeps it. The chat reappears as soon as a new message arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial desaparece solo para ti, en todos tus dispositivos. %@ lo conserva. El chat vuelve a aparecer en cuanto llegue un mensaje nuevo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История исчезнет только для тебя, на всех твоих устройствах. У %@ она останется. Чат появится снова, как только придёт новое сообщение."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประวัติจะหายไปเฉพาะสำหรับคุณ บนทุกอุปกรณ์ของคุณ %@ ยังคงเก็บไว้ แชทจะกลับมาเมื่อมีข้อความใหม่เข้ามา"
          }
        }
      }
    },
    "Der Verlauf verschwindet nur bei dir, auf allen deinen Geräten; der Chat wird archiviert. Die anderen behalten ihn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verlauf verschwindet nur bei dir, auf allen deinen Geräten; der Chat wird archiviert. Die anderen behalten ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The history disappears only for you, on all your devices; the chat is archived. The others keep it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial desaparece solo para ti, en todos tus dispositivos; el chat se archiva. Los demás lo conservan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История исчезнет только для тебя, на всех твоих устройствах; чат будет перенесён в архив. У остальных она останется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประวัติจะหายไปเฉพาะสำหรับคุณ บนทุกอุปกรณ์ของคุณ และแชทจะถูกเก็บถาวร คนอื่นยังคงเก็บไว้"
          }
        }
      }
    },
    "Alle Nachrichten und Anhänge werden für alle Mitglieder gelöscht. Der Chat selbst bleibt, solange es die Gruppe bzw. Seite gibt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Nachrichten und Anhänge werden für alle Mitglieder gelöscht. Der Chat selbst bleibt, solange es die Gruppe bzw. Seite gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All messages and attachments are deleted for all members. The chat itself stays as long as the group or page exists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan todos los mensajes y adjuntos para todos los miembros. El chat en sí se mantiene mientras exista el grupo o la página."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все сообщения и вложения удаляются для всех участников. Сам чат остаётся, пока существует группа или страница."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความและไฟล์แนบทั้งหมดจะถูกลบสำหรับสมาชิกทุกคน ตัวแชทยังคงอยู่ตราบที่กลุ่มหรือหน้ายังมีอยู่"
          }
        }
      }
    },
    "Der Chat wird für %@ und dich gelöscht – mit allen Nachrichten, Anhängen und Anrufen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Chat wird für %@ und dich gelöscht – mit allen Nachrichten, Anhängen und Anrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chat is deleted for %@ and you – with all messages, attachments and calls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El chat se elimina para %@ y para ti, con todos los mensajes, adjuntos y llamadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чат удаляется для %@ и для тебя – со всеми сообщениями, вложениями и звонками."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชทจะถูกลบสำหรับ %@ และคุณ – พร้อมข้อความ ไฟล์แนบ และการโทรทั้งหมด"
          }
        }
      }
    },
    "Die Gruppe wird für alle Mitglieder gelöscht – mit allen Nachrichten, Anhängen und Anrufen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
