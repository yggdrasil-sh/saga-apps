            "state" : "translated",
            "value" : "Ahora tienes la sesión iniciada en %@ y se cerrará allí."
          }
        }
      }
    },
    "Nicht gespeichert: Du darfst diese Seite nicht bearbeiten. Deine Änderungen bleiben auf diesem Gerät als Entwurf erhalten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gespeichert: Du darfst diese Seite nicht bearbeiten. Deine Änderungen bleiben auf diesem Gerät als Entwurf erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not saved: you're not allowed to edit this page. Your changes are kept on this device as a draft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se guardó: no tienes permiso para editar esta página. Tus cambios se conservan en este dispositivo como borrador."
          }
        }
      }
    },
    "Nicht gespeichert: Diese Seite gibt es auf dem Server nicht mehr. Deine Änderungen bleiben auf diesem Gerät als Entwurf erhalten." : {
      "localizations" : {
