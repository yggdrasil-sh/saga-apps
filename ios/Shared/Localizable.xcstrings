    "Beides nicht mehr vorhanden? Neue Schlüssel – ältere Nachrichten sind danach nicht mehr lesbar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beides nicht mehr vorhanden? Neue Schlüssel – ältere Nachrichten sind danach nicht mehr lesbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neither available any more? New keys – earlier messages can't be read afterwards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya no tienes ninguna de las dos? Claves nuevas: después no podrás leer los mensajes anteriores."
          }
        }
      }
    },
    "Dafür bekommst du gleich einen Wiederherstellungsschlüssel. Damit holst du deine Chats auf ein neues Gerät, wenn kein anderes mehr da ist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafür bekommst du gleich einen Wiederherstellungsschlüssel. Damit holst du deine Chats auf ein neues Gerät, wenn kein anderes mehr da ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll get a recovery key in a moment. With it you can bring your chats to a new device when no other device is left."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un momento recibirás una clave de recuperación. Con ella puedes llevar tus chats a un dispositivo nuevo cuando no te quede ningún otro."
          }
        }
      }
    },
    "Diese Nachricht konnte keinem bestätigten Gerät des Absenders zugeordnet werden – z. B. weil das Gerät inzwischen entfernt wurde. Vergleiche im Zweifel die Sicherheitsnummer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Nachricht konnte keinem bestätigten Gerät des Absenders zugeordnet werden – z. B. weil das Gerät inzwischen entfernt wurde. Vergleiche im Zweifel die Sicherheitsnummer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This message couldn't be matched to a confirmed device of the sender – e.g. because the device has since been removed. If in doubt, compare the safety number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mensaje no se pudo asociar a ningún dispositivo confirmado del remitente, p. ej., porque el dispositivo se ha quitado entretanto. Si tienes dudas, compara el número de seguridad."
          }
        }
      }
