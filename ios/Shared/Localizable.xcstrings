    "Andere sehen dein Bild bei Kommentaren, im Chat und beim Teilen. Saga lädt Bilder nur vom eigenen Server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere sehen dein Bild bei Kommentaren, im Chat und beim Teilen. Saga lädt Bilder nur vom eigenen Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Others see your picture with comments, in chats and when sharing. Saga only loads pictures from your own server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los demás ven tu imagen en comentarios, chats y al compartir. Saga solo carga imágenes de tu propio servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие видят твоё фото в комментариях, в чатах и при общем доступе. Saga загружает фото только со своего сервера."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้อื่นจะเห็นรูปของคุณในความคิดเห็น ในแชท และเมื่อแชร์ Saga โหลดรูปจากเซิร์ฟเวอร์ของคุณเองเท่านั้น"
          }
        }
      }
