    "Saga folgt der Systemsprache. Eine eigene Sprache nur für Saga wählst du in der Einstellungen-App unter Saga → Sprache." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga folgt der Systemsprache. Eine eigene Sprache nur für Saga wählst du in der Einstellungen-App unter Saga → Sprache."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga follows the system language. To choose a language just for Saga, open the Settings app and go to Saga → Language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga usa el idioma del sistema. Para elegir un idioma solo para Saga, abre la app Ajustes y ve a Saga → Idioma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga использует язык системы. Чтобы выбрать язык только для Saga, открой приложение «Настройки» и перейди в Saga → Язык."
