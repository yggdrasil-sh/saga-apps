    "Du bist gerade bei %@ angemeldet und wirst dort abgemeldet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist gerade bei %@ angemeldet und wirst dort abgemeldet."
          }
