          "stringUnit" : {
            "state" : "translated",
            "value" : "หมายเลขความปลอดภัยของ %@ เปลี่ยนไป – ตรวจสอบก่อนหรือเลือก “รับทราบ”"
          }
        }
      }
    },
    "Die Sicherheitsnummer von %@ hat sich geändert – z. B. nach „Neu beginnen“ oder bei einem neuen Konto. Prüfe sie, bevor du Vertrauliches schreibst." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherheitsnummer von %@ hat sich geändert – z. B. nach „Neu beginnen“ oder bei einem neuen Konto. Prüfe sie, bevor du Vertrauliches schreibst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'s safety number has changed – e.g. after “Start over” or with a new account. Check it before you write anything confidential."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El número de seguridad de %@ ha cambiado, p. ej., tras «Empezar de nuevo» o con una cuenta nueva. Compruébalo antes de escribir algo confidencial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код безопасности %@ изменился – например, после «Начать заново» или с новым аккаунтом. Проверь его, прежде чем писать что-то конфиденциальное."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หมายเลขความปลอดภัยของ %@ เปลี่ยนไป – เช่น หลัง “เริ่มใหม่” หรือมีบัญชีใหม่ ตรวจสอบก่อนเขียนเรื่องที่เป็นความลับ"
          }
        }
      }
    },
