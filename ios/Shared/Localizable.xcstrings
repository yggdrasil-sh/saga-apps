    "Das Gerät bekommt keine neuen Nachrichten mehr und kann vorhandene nicht mehr abrufen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät bekommt keine neuen Nachrichten mehr und kann vorhandene nicht mehr abrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device will no longer receive new messages and can't fetch existing ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo ya no recibirá mensajes nuevos ni podrá obtener los existentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройство больше не будет получать новые сообщения и не сможет загрузить существующие."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุปกรณ์จะไม่ได้รับข้อความใหม่อีกและดึงข้อความที่มีอยู่ไม่ได้"
          }
        }
      }
    },
    "Das passt nicht – bitte genau die letzten vier Zeichen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das passt nicht – bitte genau die letzten vier Zeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That doesn't match – please enter exactly the last four characters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No coincide: introduce exactamente los últimos cuatro caracteres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не совпадает – введи точно последние четыре символа."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ตรงกัน – โปรดป้อนอักขระสี่ตัวสุดท้ายให้ถูกต้อง"
          }
        }
      }
    },
    "Dein Wiederherstellungsschlüssel" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Wiederherstellungsschlüssel"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your recovery key"
          }
        },
