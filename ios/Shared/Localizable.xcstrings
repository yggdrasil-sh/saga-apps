          "stringUnit" : {
            "state" : "translated",
            "value" : "คีย์กู้คืนของคุณ"
          }
        }
      }
    },
    "Deine Chats sind Ende-zu-Ende-verschlüsselt. Damit dieses Gerät sie lesen kann, braucht es deine Schlüssel – wähle einen Weg:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Chats sind Ende-zu-Ende-verschlüsselt. Damit dieses Gerät sie lesen kann, braucht es deine Schlüssel – wähle einen Weg:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your chats are end-to-end encrypted. For this device to read them it needs your keys – choose a way:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus chats están cifrados de extremo a extremo. Para que este dispositivo pueda leerlos necesita tus claves; elige una opción:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои чаты защищены сквозным шифрованием. Чтобы это устройство могло их читать, ему нужны твои ключи – выбери способ:"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชทของคุณเข้ารหัสแบบต้นทางถึงปลายทาง อุปกรณ์นี้ต้องมีคีย์ของคุณจึงจะอ่านได้ – เลือกวิธี:"
          }
        }
      }
    },
    "Deine Schlüssel auf dem Server passen nicht zu diesem Gerät." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Schlüssel auf dem Server passen nicht zu diesem Gerät."
