        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gruppe %@ verliert sofort den Zugriff auf diese Seite und ihre Unterseiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The group %@ immediately loses access to this page and its subpages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El grupo %@ pierde de inmediato el acceso a esta página y sus subpáginas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Группа %@ сразу теряет доступ к этой странице и её подстраницам."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลุ่ม %@ จะเสียสิทธิ์เข้าถึงหน้านี้และหน้าย่อยทันที"
          }
        }
      }
    },
    "Die Seite gibt es nicht (mehr), oder sie ist nicht (mehr) mit dir geteilt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seite gibt es nicht (mehr), oder sie ist nicht (mehr) mit dir geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The page doesn’t exist (anymore), or it is not (or no longer) shared with you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La página no existe (ya) o no está (ya) compartida contigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страница не существует (больше) или не открыта (больше) для тебя."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้านี้ไม่มีอยู่ (แล้ว) หรือไม่ได้แชร์กับคุณ (อีกต่อไป)"
          }
        }
      }
    },
    "Die neue Version ist geladen. Dein nicht gespeicherter Text steht unten – kopiere, was du behalten willst." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Version ist geladen. Dein nicht gespeicherter Text steht unten – kopiere, was du behalten willst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new version is loaded. Your unsaved text is below – copy whatever you want to keep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nueva versión está cargada. Tu texto sin guardar está abajo: copia lo que quieras conservar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружена новая версия. Твой несохранённый текст ниже – скопируй то, что хочешь сохранить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหลดเวอร์ชันใหม่แล้ว ข้อความที่ยังไม่บันทึกของคุณอยู่ด้านล่าง – คัดลอกส่วนที่ต้องการเก็บไว้"
          }
        }
      }
    },
    "Diese Freigaben gelten auch hier. Ändern kannst du sie auf der übergeordneten Seite." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Freigaben gelten auch hier. Ändern kannst du sie auf der übergeordneten Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These shares also apply here. You can change them on the parent page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos usos compartidos también se aplican aquí. Puedes cambiarlos en la página superior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот общий доступ действует и здесь. Изменить его можно на родительской странице."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแชร์เหล่านี้มีผลที่นี่ด้วย คุณเปลี่ยนได้ที่หน้าหลัก"
          }
        }
      }
    },
