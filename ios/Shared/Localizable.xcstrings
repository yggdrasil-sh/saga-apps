    "Externe Kalender (CalDAV) wie mailcow oder Nextcloud verbinden. Tipp: In mailcow ein eigenes App-Passwort nur für „DAV“ anlegen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Externe Kalender (CalDAV) wie mailcow oder Nextcloud verbinden. Tipp: In mailcow ein eigenes App-Passwort nur für „DAV“ anlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect external calendars (CalDAV) such as mailcow or Nextcloud. Tip: in mailcow, create a separate app password just for “DAV”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta calendarios externos (CalDAV) como mailcow o Nextcloud. Consejo: en mailcow, crea una contraseña de aplicación solo para «DAV»."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключай внешние календари (CalDAV), например mailcow или Nextcloud. Совет: в mailcow создай отдельный пароль приложения только для «DAV»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อปฏิทินภายนอก (CalDAV) เช่น mailcow หรือ Nextcloud เคล็ดลับ: ใน mailcow ให้สร้างรหัสผ่านแอปแยกสำหรับ “DAV” โดยเฉพาะ"
          }
        }
      }
    },
