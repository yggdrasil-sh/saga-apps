    "Er kann nichts ändern: Vorschläge übernimmst du selbst. Chats liest er nie; Aufgaben und Kalender nur, wenn du sie einschaltest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kann nichts ändern: Vorschläge übernimmst du selbst. Chats liest er nie; Aufgaben und Kalender nur, wenn du sie einschaltest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It can't change anything: you apply suggestions yourself. It never reads chats; tasks and calendar only when you turn them on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puede cambiar nada: tú aplicas las sugerencias. Nunca lee chats; tareas y calendario solo si los activas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он ничего не может изменить: предложения применяешь ты сам. Он никогда не читает чаты; задачи и календарь – только если ты их включишь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ช่วยเปลี่ยนแปลงอะไรไม่ได้: คุณเป็นผู้ใช้คำแนะนำเอง ผู้ช่วยไม่อ่านแชท ส่วนงานและปฏิทินจะอ่านเมื่อคุณเปิดใช้เท่านั้น"
          }
        }
      }
    },
    "Erscheinen in Saga unter der Glocke – sofort, solange Saga offen ist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheinen in Saga unter der Glocke – sofort, solange Saga offen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shown in Saga under the bell – instantly while Saga is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparecen en Saga bajo la campana, al instante mientras Saga esté abierto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывается в Saga под колокольчиком – сразу, пока Saga открыта."
