    "Saga – Wiederherstellungsschlüssel für Chats" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga – Wiederherstellungsschlüssel für Chats"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga – recovery key for chats"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga – clave de recuperación de los chats"
          }
        }
      }
    },
    "Saga-Chats sind Ende-zu-Ende-verschlüsselt: Nachrichten und Anhänge werden auf deinen Geräten ver- und entschlüsselt. Der Server – auch der Admin – sieht nur verschlüsselte Daten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga-Chats sind Ende-zu-Ende-verschlüsselt: Nachrichten und Anhänge werden auf deinen Geräten ver- und entschlüsselt. Der Server – auch der Admin – sieht nur verschlüsselte Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga chats are end-to-end encrypted: messages and attachments are encrypted and decrypted on your devices. The server – including the admin – only sees encrypted data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los chats de Saga están cifrados de extremo a extremo: los mensajes y adjuntos se cifran y descifran en tus dispositivos. El servidor, incluido el administrador, solo ve datos cifrados."
          }
        }
      }
    },
