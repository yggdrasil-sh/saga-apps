    "Gespeichert werden Fragen, Antworten und die Quellseiten. Quellen ohne Zugriff zeigen keinen Titel mehr." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert werden Fragen, Antworten und die Quellseiten. Quellen ohne Zugriff zeigen keinen Titel mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questions, answers and source pages are saved. Sources you no longer have access to don't show a title."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardan las preguntas, las respuestas y las páginas de origen. Las fuentes sin acceso ya no muestran título."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вопросы, ответы и страницы-источники сохраняются. Для источников, к которым у тебя больше нет доступа, название не показывается."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำถาม คำตอบ และหน้าแหล่งที่มาจะถูกบันทึก แหล่งที่มาที่คุณไม่มีสิทธิ์เข้าถึงแล้วจะไม่แสดงชื่อ"
          }
        }
      }
    },
