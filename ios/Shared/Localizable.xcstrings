      }
    },
    "„%@“ ist zu groß (höchstens %lld MB)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist zu groß (höchstens %lld MB)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” is too large (at most %2$lld MB)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» es demasiado grande (máximo %2$lld MB)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» слишком большой (максимум %2$lld МБ)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ใหญ่เกินไป (สูงสุด %2$lld MB)"
          }
        }
      }
    },
    "„%@“ möchte auf deine Chats zugreifen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ möchte auf deine Chats zugreifen."
          }
        },
        "en" : {
