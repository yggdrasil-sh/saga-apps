    "Den QR-Code zeigt Saga im Browser unter 👤 → Einstellungen → „Apps & Geräte“." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den QR-Code zeigt Saga im Browser unter 👤 → Einstellungen → „Apps & Geräte“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga shows the QR code in the browser under 👤 → Settings → “Apps & devices”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saga muestra el código QR en el navegador en 👤 → Ajustes → «Apps y dispositivos»."
          }
        }
      }
    },
    "Den Schlüssel erzeugst du im Web unter 👤 → Einstellungen → „Apps & Geräte“. In der App genügt dort „In dieser App verwenden“." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Schlüssel erzeugst du im Web unter 👤 → Einstellungen → „Apps & Geräte“. In der App genügt dort „In dieser App verwenden“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create the key on the web under 👤 → Settings → “Apps & devices”. In the app, “Use in this app” is all it takes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea la clave en la web en 👤 → Ajustes → «Apps y dispositivos». En la app basta con «Usar en esta app»."
          }
        }
      }
    },
