            "value" : "Permitir a %@ en este chat"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить %@ в этом чате"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาต %@ ในแชทนี้"
          }
        }
      }
    },
    "gefragt von %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gefragt von %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "asked by %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "preguntado por %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "спросил(а) %@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถามโดย %@"
          }
        }
      }
    },
    "%@ ist in diesem Chat erlaubt – nur auf Zuruf: Nachrichten mit @%@ und bis zu %lld Nachrichten davor gehen im Klartext an die KI (%@). Alles andere bleibt Ende-zu-Ende-verschlüsselt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist in diesem Chat erlaubt – nur auf Zuruf: Nachrichten mit @%@ und bis zu %lld Nachrichten davor gehen im Klartext an die KI (%@). Alles andere bleibt Ende-zu-Ende-verschlüsselt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is allowed in this chat – only when mentioned: messages with @%2$@ and up to %3$lld messages before go to the AI (%4$@) in plain text. Everything else stays end-to-end encrypted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está permitida en este chat, solo si se la menciona: los mensajes con @%2$@ y hasta %3$lld mensajes anteriores se envían a la IA (%4$@) en texto claro. Todo lo demás sigue cifrado de extremo a extremo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ разрешён в этом чате – только при упоминании: сообщения с @%2$@ и до %3$lld предыдущих сообщений уходят к ИИ (%4$@) открытым текстом. Всё остальное остаётся под сквозным шифрованием."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ได้รับอนุญาตในแชทนี้ – เฉพาะเมื่อถูกกล่าวถึง: ข้อความที่มี @%2$@ และข้อความก่อนหน้าไม่เกิน %3$lld ข้อความจะส่งไปยัง AI (%4$@) เป็นข้อความธรรมดา ส่วนอื่นทั้งหมดยังคงเข้ารหัสแบบต้นทางถึงปลายทาง"
          }
        }
      }
    },
    "Geht an %@: diese Nachricht und bis zu %lld davor, im Klartext an %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geht an %@: diese Nachricht und bis zu %lld davor, im Klartext an %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goes to %1$@: this message and up to %2$lld before, in plain text to %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía a %1$@: este mensaje y hasta %2$lld anteriores, en texto claro a %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уйдёт к %1$@: это сообщение и до %2$lld предыдущих, открытым текстом на %3$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งไปยัง %1$@: ข้อความนี้และข้อความก่อนหน้าไม่เกิน %2$lld ข้อความ เป็นข้อความธรรมดาไปยัง %3$@"
          }
        }
      }
    },
    "%@ in diesem Chat erlauben?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in diesem Chat erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow %@ in this chat?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir a %@ en este chat?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить %@ в этом чате?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาต %@ ในแชทนี้หรือไม่"
          }
        }
      }
    },
    "Dann kann jede Person im Chat %@ mit @%@ fragen. Nur diese Nachricht und bis zu %lld Nachrichten davor gehen im Klartext an die KI (%@) – der Server speichert sie nicht. Alle Mitglieder sehen einen Hinweis." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann kann jede Person im Chat %@ mit @%@ fragen. Nur diese Nachricht und bis zu %lld Nachrichten davor gehen im Klartext an die KI (%@) – der Server speichert sie nicht. Alle Mitglieder sehen einen Hinweis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone in the chat can then ask %1$@ with @%2$@. Only that message and up to %3$lld messages before go to the AI (%4$@) in plain text – the server doesn't store them. All members see a notice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así, cualquier persona del chat podrá preguntar a %1$@ con @%2$@. Solo ese mensaje y hasta %3$lld mensajes anteriores se envían a la IA (%4$@) en texto claro; el servidor no los guarda. Todos los miembros ven un aviso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тогда каждый в чате сможет спросить %1$@ через @%2$@. К ИИ (%4$@) открытым текстом уходят только это сообщение и до %3$lld предыдущих – сервер их не хранит. Все участники видят уведомление."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกคนในแชทจะถาม %1$@ ได้ด้วย @%2$@ เฉพาะข้อความนั้นและข้อความก่อนหน้าไม่เกิน %3$lld ข้อความจะส่งไปยัง AI (%4$@) เป็นข้อความธรรมดา – เซิร์ฟเวอร์ไม่เก็บไว้ สมาชิกทุกคนจะเห็นประกาศ"
          }
        }
      }
    },
