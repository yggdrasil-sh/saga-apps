<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 (targetSdk 37): Server im lokalen Netz (Heimnetz, Split-DNS, *.local) nur mit dieser Berechtigung
         ("Geraete in der Naehe"); die App fragt erst, wenn der Server tatsaechlich auf eine lokale Adresse zeigt -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Mitteilungen (Push ueber UnifiedPush, Android 13+ fragt nach) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Kamera nur fuer die QR-Anmeldung: Geraete ohne Kamera bleiben unterstuetzt -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Anrufe (2.1, WebRTC): Mikrofon/Kamera nur waehrend eines Anrufs; Klingeln als Vollbild-Benachrichtigung;
         laufender Anruf als Vordergrund-Dienst (Typ phoneCall, selbstverwaltet ueber MANAGE_OWN_CALLS) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- 2.4: Bildschirm im Anruf teilen (MediaProjection, Vordergrund-Dienst Typ mediaProjection) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- 2.4 Videos im Chat: Upload im Hintergrund (WorkManager, expedited) als Vordergrund-Arbeit mit Mitteilung -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 2.5 Sprachnachrichten: Wiedergabe laeuft im Hintergrund weiter (Vordergrund-Dienst Typ mediaPlayback, nur waehrend
         der Wiedergabe; WakeLock fuer ExoPlayer). Aufnahme nur im Vordergrund (RECORD_AUDIO oben, Abfrage zur Laufzeit). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <!-- Custom Tabs (Anmeldung im Browser) -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- UnifiedPush-Verteiler (z. B. ntfy) finden -->
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <application
        android:name=".SagaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Saga"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Rueckkehr aus der Browser-Anmeldung: saga://auth?code=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="saga" android:host="auth" />
            </intent-filter>
            <!-- Teilen-Ziel: Text oder Link aus einer anderen App als Seite (Eingang) oder Aufgabe sichern -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Kopplung per QR-Code (Link aus der Kamera-App): saga://pair?u=...&c=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="saga" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- UnifiedPush: Antworten der Verteiler-App (Adresse, Mitteilungen) - kein Google FCM -->
        <receiver
            android:name=".push.PushReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
            </intent-filter>
        </receiver>

        <!-- Anrufe: Vollbild (auch auf dem Sperrbildschirm), Vordergrund-Dienst, Aktionen aus der Mitteilung -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="io.github.yggdrasil_sh.saga.call"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode|locale|layoutDirection|fontScale"
            tools:targetApi="27" />

        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera|mediaProjection" />

        <!-- 2.5 Gjallarhorn: Gruppenanrufe ueber Knoten als selbstverwaltete Anrufe beim System (Telecom, MANAGE_OWN_CALLS) -->
        <service
            android:name=".call.SagaConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false" />

        <!-- 2.5: Sprachnachrichten im Hintergrund weiter abspielen -->
        <service
            android:name=".chat.voice.VoicePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 2.4: Video-Upload (WorkManager) laeuft als Vordergrund-Arbeit vom Typ dataSync -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Chat-Anhaenge (entschluesselt im Cache) an andere Apps weitergeben -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
