<?xml version="1.0" encoding="utf-8"?>
<!-- Nur Debug-Build: Klartext (http) erlaubt, damit Testserver im privaten Netz (z. B. http://192.168.1.12:8241,
     Emulator 10.0.2.2, adb reverse 127.0.0.1) erreichbar sind. Welche Adressen die App ueberhaupt annimmt, prueft
     ServerUrl.isPrivateHost (nur private Netze). Release: src/main/res/xml/network_security_config.xml - nur https. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
            <!-- bewusst (Review M4): eigene CA selbst gehosteter Server -->
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
</network-security-config>
