msgid "Continue"
msgstr "Далее"

#: hlidskjalf/chatview.py:2541
msgid "To confirm, enter the last four characters of your recovery key."
msgstr "Для подтверждения введи последние четыре символа ключа восстановления."

#: hlidskjalf/chatview.py:2544
msgid "Last four characters"
msgstr "Последние четыре символа"

#: hlidskjalf/chatview.py:2553
