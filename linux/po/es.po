#: hlidskjalf/window.py:751
msgid ""
"Ctrl+K / Ctrl+P – Command palette (Ctrl+K with a selection: link)\n"
"Ctrl+N – New page\n"
"Alt+← / Alt+→ – Back / Forward\n"
"Ctrl+R – Refresh\n"
"Ctrl+, – Settings\n"
"Ctrl+Shift+L – Copy link to page\n"
"Ctrl+Shift+F – Search the sidebar\n"
"F9 / Ctrl+\\ – Show/hide sidebar\n"
"Ctrl+1/2/3 – Today / Tasks / Events\n"
"Esc – Close peek\n"
"Ctrl+Shift+J/K – Browse in peek\n"
"\n"
"In text:\n"
"Ctrl+B/I/U – Bold, italic, underline\n"
"Ctrl+Shift+X – Strikethrough\n"
"Ctrl+Shift+H – Highlight\n"
"Ctrl+E – Code\n"
"/ – Block types   @ – Date, reminder, page   : – Emoji\n"
"# ## ### - * 1. [] > ``` --- at the start of a line – Block type\n"
"Ctrl+Alt+0…8 – Text, Heading 1–3, Checklist, Bulleted list, Numbered list, Toggle, Code\n"
"Ctrl+Shift+↑/↓ – Move block\n"
"Ctrl+D – Duplicate block\n"
"Ctrl+Enter – New block below\n"
"Tab / Shift+Tab – Indent/outdent list item"
msgstr ""
"Ctrl+K / Ctrl+P – Paleta de comandos (Ctrl+K con selección: enlace)\n"
"Ctrl+N – Nueva página\n"
"Alt+← / Alt+→ – Atrás / Adelante\n"
"Ctrl+R – Actualizar\n"
"Ctrl+, – Ajustes\n"
"Ctrl+Mayús+L – Copiar enlace a la página\n"
"Ctrl+Mayús+F – Buscar en la barra lateral\n"
"F9 / Ctrl+\\ – Mostrar u ocultar la barra lateral\n"
"Ctrl+1/2/3 – Hoy / Tareas / Eventos\n"
"Esc – Cerrar vista rápida\n"
"Ctrl+Mayús+J/K – Pasar entradas en la vista rápida\n"
"\n"
"En el texto:\n"
"Ctrl+B/I/U – Negrita, cursiva, subrayado\n"
"Ctrl+Mayús+X – Tachado\n"
"Ctrl+Mayús+H – Resaltar\n"
"Ctrl+E – Código\n"
"/ – Tipos de bloque   @ – Fecha, recordatorio, página   : – Emoji\n"
"# ## ### - * 1. [] > ``` --- al inicio de la línea – Tipo de bloque\n"
"Ctrl+Alt+0…8 – Texto, Encabezado 1–3, Lista de verificación, Viñetas, Lista numerada, Desplegable, Código\n"
"Ctrl+Mayús+↑/↓ – Mover bloque\n"
"Ctrl+D – Duplicar bloque\n"
"Ctrl+Intro – Nuevo bloque debajo\n"
"Tab / Mayús+Tab – Aumentar/reducir sangría"

