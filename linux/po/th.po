msgid "Nobody blocked."
msgstr "ไม่มีใครถูกบล็อก"

#: hlidskjalf/chatview.py:3728
msgid "whole server"
msgstr "ทั้งเซิร์ฟเวอร์"

#: hlidskjalf/chatview.py:3729
msgid "Unblock"
msgstr "เลิกบล็อก"

#: hlidskjalf/chatview.py:3742
msgid "Privacy"
msgstr "ความเป็นส่วนตัว"

