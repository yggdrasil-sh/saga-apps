msgstr "Neuen Wiederherstellungsschlüssel erzeugen?"

#: hlidskjalf/chatview.py:3801
msgid "The previous key will stop working."
msgstr "Der bisherige Schlüssel funktioniert danach nicht mehr."

#: hlidskjalf/chatview.py:3807 hlidskjalf/chatview.py:3812
msgid "New recovery key"
msgstr "Neuer Wiederherstellungsschlüssel"

#: hlidskjalf/chatview.py:3812
