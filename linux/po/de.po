msgstr "Geräte mit Zugriff auf deine Chats"

#: hlidskjalf/chatview.py:3639
msgid "Chats are not set up yet – open “Chats” in the sidebar."
msgstr ""
"Chats sind noch nicht eingerichtet – öffne „Chats“ in der Seitenleiste."

#: hlidskjalf/chatview.py:3644
#, python-brace-format
msgid "added {when}"
msgstr "angemeldet {when}"

#: hlidskjalf/chatview.py:3644 hlidskjalf/push.py:428
