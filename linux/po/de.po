#: hlidskjalf/window.py:751
msgid ""
"Ctrl+K / Ctrl+P – Command palette (Ctrl+K with a selection: link)\n"
"Ctrl+N – New page\n"
"Alt+← / Alt+→ – Back / Forward\n"
"Ctrl+R – Refresh\n"
"Ctrl+, – Settings\n"
"Ctrl+Shift+L – Copy link to page\n"
"Ctrl+Shift+F – Search the sidebar\n"
"F9 / Ctrl+\\ – Show/hide sidebar\n"
"Ctrl+1/2/3 – Today / Tasks / Events\n"
"Esc – Close peek\n"
"Ctrl+Shift+J/K – Browse in peek\n"
"\n"
"In text:\n"
"Ctrl+B/I/U – Bold, italic, underline\n"
"Ctrl+Shift+X – Strikethrough\n"
"Ctrl+Shift+H – Highlight\n"
"Ctrl+E – Code\n"
"/ – Block types   @ – Date, reminder, page   : – Emoji\n"
"# ## ### - * 1. [] > ``` --- at the start of a line – Block type\n"
"Ctrl+Alt+0…8 – Text, Heading 1–3, Checklist, Bulleted list, Numbered list, Toggle, Code\n"
"Ctrl+Shift+↑/↓ – Move block\n"
"Ctrl+D – Duplicate block\n"
"Ctrl+Enter – New block below\n"
"Tab / Shift+Tab – Indent/outdent list item"
msgstr ""
"Strg+K / Strg+P – Befehlspalette (Strg+K mit Auswahl: Link)\n"
"Strg+N – Neue Seite\n"
"Alt+← / Alt+→ – Zurück / Vor\n"
"Strg+R – Aktualisieren\n"
"Strg+, – Einstellungen\n"
"Strg+Umschalt+L – Link zur Seite kopieren\n"
"Strg+Umschalt+F – Seitenleiste durchsuchen\n"
"F9 / Strg+\\ – Seitenleiste ein-/ausblenden\n"
"Strg+1/2/3 – Heute / Aufgaben / Termine\n"
"Esc – Peek schließen\n"
"Strg+Umschalt+J/K – Im Peek blättern\n"
"\n"
"Im Text:\n"
"Strg+B/I/U – Fett, kursiv, unterstrichen\n"
"Strg+Umschalt+X – Durchgestrichen\n"
"Strg+Umschalt+H – Markieren\n"
"Strg+E – Code\n"
"/ – Blocktypen   @ – Datum, Erinnerung, Seite   : – Emoji\n"
"# ## ### - * 1. [] > ``` --- am Zeilenanfang – Blocktyp\n"
"Strg+Alt+0…8 – Text, Überschrift 1–3, Checkliste, Aufzählung, Nummeriert, Toggle, Code\n"
"Strg+Umschalt+↑/↓ – Block verschieben\n"
"Strg+D – Block duplizieren\n"
"Strg+Enter – Neuer Block darunter\n"
"Tab / Umschalt+Tab – Listenpunkt ein-/ausrücken"

