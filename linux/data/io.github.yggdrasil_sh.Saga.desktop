[Desktop Entry]
Type=Application
Name=Saga
GenericName=Notes and Databases
GenericName[de]=Notizen und Datenbanken
GenericName[es]=Notas y bases de datos
GenericName[ru]=Заметки и базы данных
GenericName[th]=โน้ตและฐานข้อมูล
Comment=Notes, databases, tasks and events – self-hosted
Comment[de]=Notizen, Datenbanken, Aufgaben und Termine – selbst gehostet
Comment[es]=Notas, bases de datos, tareas y eventos en tu propio servidor
Comment[ru]=Заметки, базы данных, задачи и события – на собственном сервере
Comment[th]=โน้ต ฐานข้อมูล งาน และกิจกรรม – โฮสต์ด้วยตัวเอง
Exec=hlidskjalf %u
Icon=io.github.yggdrasil_sh.Saga
Terminal=false
Categories=Office;GTK;
Keywords=Notion;Notes;Wiki;Database;Tasks;Calendar;
Keywords[de]=Notion;Notizen;Wiki;Datenbank;Aufgaben;Kalender;
Keywords[es]=Notion;Notas;Wiki;Base de datos;Tareas;Calendario;
Keywords[ru]=Notion;Заметки;Вики;База данных;Задачи;Календарь;
Keywords[th]=Notion;โน้ต;วิกิ;ฐานข้อมูล;งาน;ปฏิทิน;
MimeType=x-scheme-handler/hlidskjalf;
StartupNotify=true
StartupWMClass=io.github.yggdrasil_sh.Saga
DBusActivatable=false
Actions=new-page;new-task;

[Desktop Action new-page]
Name=New Page
Name[de]=Neue Seite
Name[es]=Nueva página
Name[ru]=Новая страница
Name[th]=หน้าใหม่
Exec=hlidskjalf --new-page

[Desktop Action new-task]
Name=New Task
Name[de]=Neue Aufgabe
Name[es]=Nueva tarea
Name[ru]=Новая задача
Name[th]=งานใหม่
Exec=hlidskjalf --new-task
